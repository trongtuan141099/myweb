<!-- Custom Tooltip Container -->
<div id="customTooltip" class="custom-tooltip-box"></div>

<!-- JavaScript Logic Chính -->
<script>
let currentMode = 'standard';
let timelineRawData = null;
let currentPlanPage = 1;
let selectedPlanIds = [];
let empSearchTimeout = null;
let currentSearchItems = [];
let focusedSearchIndex = -1;

// Biến quản lý Ma trận Phân bổ nhóm làm việc
let matrixAllocations = [];
let matrixSelectedCodes = [];
let draggedEmpCode = null;
let draggedFromGroup = null;

document.addEventListener('DOMContentLoaded', function() {
  loadTimelineData();
  loadSyncConfig();
  loadHrmAccounts();

  // Đóng dropdown autocomplete khi click ra ngoài
  document.addEventListener('click', function(e) {
    const box = document.getElementById('empSuggestionBox');
    const input = document.getElementById('planEmpSearch');
    if (box && !box.contains(e.target) && e.target !== input) {
      box.style.display = 'none';
    }
  });
});

// Chuyển Tab Chính
function switchMainTab(tabName) {
  document.querySelectorAll('.leave-main-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('tabContentTimeline').style.display = 'none';
  document.getElementById('tabContentPlans').style.display = 'none';
  document.getElementById('tabContentSync').style.display = 'none';

  if (tabName === 'timeline') {
    document.getElementById('tabBtnTimeline').classList.add('active');
    document.getElementById('tabContentTimeline').style.display = 'block';
  } else if (tabName === 'plans') {
    document.getElementById('tabBtnPlans').classList.add('active');
    document.getElementById('tabContentPlans').style.display = 'block';
    loadPlansData(1);
  } else if (tabName === 'sync') {
    document.getElementById('tabBtnSync').classList.add('active');
    document.getElementById('tabContentSync').style.display = 'block';
    loadSyncConfig();
    loadHrmAccounts();
  }
}

// Chuyển Chế Độ Timeline
function setTimelineMode(mode) {
  currentMode = mode;
  document.querySelectorAll('.mode-pill').forEach(b => b.classList.remove('active'));
  if (mode === 'standard') document.getElementById('modeBtnStandard').classList.add('active');
  else if (mode === 'plan') document.getElementById('modeBtnPlan').classList.add('active');
  else if (mode === 'actual') document.getElementById('modeBtnActual').classList.add('active');
  else if (mode === 'compare') document.getElementById('modeBtnCompare').classList.add('active');

  loadTimelineData();
}

// 1. Tải Ma Trận Timeline & Bảng Quân Số Nhóm từ API
function loadTimelineData() {
  const month = document.getElementById('filterMonth').value;
  const year  = document.getElementById('filterYear').value;
  const group = document.getElementById('filterGroup').value;
  const search = document.getElementById('filterSearch').value.trim();

  document.getElementById('manpowerMonthLabel').textContent = `Tháng ${month}/${year}`;

  const tbody = document.getElementById('timelineTbody');
  tbody.innerHTML = `<tr><td colspan="35" class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>Đang nạp dữ liệu timeline...</div></td></tr>`;

  fetch(`api/hrm_leave.php?action=get_timeline&month=${month}&year=${year}&group_name=${encodeURIComponent(group)}&search=${encodeURIComponent(search)}&mode=${currentMode}`)
    .then(r => r.json())
    .then(res => {
      if (!res.success) {
        tbody.innerHTML = `<tr><td colspan="35" class="text-center py-4 text-danger">${res.message || 'Lỗi tải timeline'}</td></tr>`;
        return;
      }
      timelineRawData = res.data;
      renderManpowerMatrix(timelineRawData);
      renderTimeline(timelineRawData);
      updateTopMetrics(timelineRawData);
    })
    .catch(err => {
      tbody.innerHTML = `<tr><td colspan="35" class="text-center py-4 text-danger">Lỗi kết nối máy chủ: ${err}</td></tr>`;
    });
}

// 2. Render Bảng Theo Dõi Quân Số Nhóm Làm Việc (Manpower Matrix)
function renderManpowerMatrix(data) {
  const thead = document.getElementById('manpowerThead');
  const tbody = document.getElementById('manpowerTbody');
  const daysInMonth = data.days_in_month;
  const today = data.today;
  const curYear = data.year;
  const curMonth = data.month;

  // Header
  let thRow1 = `<tr>
    <th class="col-grp-name" rowspan="2">Nhóm Làm Việc</th>
    <th class="col-grp-total" rowspan="2">Tổng NS</th>`;
  let thRow2 = `<tr>`;

  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${curYear}-${String(curMonth).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const dt = new Date(curYear, curMonth - 1, d);
    const dayOfWeek = dt.getDay(); // 0 is Sunday
    const isSunday = (dayOfWeek === 0);
    const isToday = (dateStr === today);

    const dowName = isSunday ? 'CN' : ('T' + (dayOfWeek + 1));
    const thClass = isToday ? 'th-today' : (isSunday ? 'th-sunday' : '');

    thRow1 += `<th style="width:30px;" class="${thClass} ${isSunday ? 'bg-sunday' : ''}">${d}</th>`;
    thRow2 += `<th style="font-size:10px;" class="${isSunday ? 'th-sunday bg-sunday' : 'text-muted'}">${dowName}</th>`;
  }
  thRow1 += `</tr>`;
  thRow2 += `</tr>`;
  thead.innerHTML = thRow1 + thRow2;

  // Rows
  if (!data.work_group_summary || data.work_group_summary.length === 0) {
    tbody.innerHTML = `<tr><td colspan="${daysInMonth + 2}" class="text-center py-3 text-muted">Không có dữ liệu nhóm làm việc</td></tr>`;
    return;
  }

  let html = '';
  data.work_group_summary.forEach(wg => {
    let grpBadgeClass = 'badge-wg-khac';
    const gn = wg.work_group.toLowerCase();
    if (gn.includes('tu')) grpBadgeClass = 'badge-wg-dun_tu';
    else if (gn.includes('đùn t') || gn.includes('t extrusion')) grpBadgeClass = 'badge-wg-dun_t';
    else if (gn.includes('thiết bị')) grpBadgeClass = 'badge-wg-thiet_bi';
    else if (gn.includes('shotblast') || gn.includes('bắn cát')) grpBadgeClass = 'badge-wg-shotblast';
    else if (gn.includes('nghiền')) grpBadgeClass = 'badge-wg-nghien_nhua';

    html += `<tr>
      <td class="col-grp-name">
        <span class="badge-workgroup ${grpBadgeClass} me-1">${wg.work_group}</span>
      </td>
      <td class="col-grp-total font-monospace">${wg.total_emps}</td>`;

    for (let d = 1; d <= daysInMonth; d++) {
      const leaves = wg.daily_leaves[d] || 0;
      const working = wg.daily_working[d];
      let display = '<span class="text-muted opacity-50">-</span>';

      if (leaves > 0) {
        const heavyClass = (leaves >= 3) ? 'heavy-leaves' : 'has-leaves';
        display = `<span class="manpower-cell-leave ${heavyClass}" title="${wg.work_group} - Ngày ${d}: ${leaves} nghỉ, ${working} đi làm">${leaves}</span>`;
      }

      html += `<td>${display}</td>`;
    }
    html += `</tr>`;
  });

  // Hàng tổng toàn xưởng
  html += `<tr style="background: var(--dx-bg-subtle, #f8fafc); font-weight: 700;">
    <td class="col-grp-name text-primary">Tổng nghỉ toàn xưởng</td>
    <td class="col-grp-total text-primary font-monospace">${data.total_employees}</td>`;
  for (let d = 1; d <= daysInMonth; d++) {
    const tot = data.daily_stats_total[d] || 0;
    const disp = tot > 0 ? `<strong class="text-danger">${tot}</strong>` : '<span class="text-muted opacity-50">-</span>';
    html += `<td>${disp}</td>`;
  }
  html += `</tr>`;

  tbody.innerHTML = html;
}

// 3. Render Giao Diện Bảng Ma Trận Timeline Chi Tiết
function renderTimeline(data) {
  const thead = document.getElementById('timelineThead');
  const tbody = document.getElementById('timelineTbody');

  const daysInMonth = data.days_in_month;
  const today = data.today;
  const curYear = data.year;
  const curMonth = data.month;

  // Thead
  let thRow1 = `<tr>
    <th class="col-sticky-stt" rowspan="2">STT</th>
    <th class="col-sticky-code" rowspan="2">Mã NV</th>
    <th class="col-sticky-name" rowspan="2">Họ và tên</th>`;
  let thRow2 = `<tr>`;

  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${curYear}-${String(curMonth).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const dt = new Date(curYear, curMonth - 1, d);
    const dayOfWeek = dt.getDay();
    const isSunday = (dayOfWeek === 0);
    const isToday = (dateStr === today);

    const dowName = isSunday ? 'CN' : ('T' + (dayOfWeek + 1));
    const thClass = isToday ? 'th-today' : (isSunday ? 'th-sunday' : '');

    thRow1 += `<th class="day-cell ${thClass} ${isSunday ? 'bg-sunday' : ''}">${d}</th>`;
    thRow2 += `<th class="day-cell ${isSunday ? 'th-sunday bg-sunday' : 'text-muted'}" style="font-size:10px;">${dowName}</th>`;
  }
  thRow1 += `</tr>`;
  thRow2 += `</tr>`;
  thead.innerHTML = thRow1 + thRow2;

  // Tbody
  if (!data.groups || data.groups.length === 0) {
    tbody.innerHTML = `<tr><td colspan="${daysInMonth + 3}" class="text-center py-5 text-muted">Không tìm thấy nhân viên phù hợp</td></tr>`;
    return;
  }

  let html = '';
  let globalStt = 1;

  data.groups.forEach(grp => {
    // Dòng Header Nhóm Làm Việc
    html += `<tr class="group-header-row">
      <td colspan="${daysInMonth + 3}">
        <span class="material-icons align-middle me-1 text-primary" style="font-size:16px;">workspaces</span>
        <strong>${grp.group_name}</strong>
        <span class="badge bg-light text-muted border ms-2">${grp.total_emps} nhân sự</span>
      </td>
    </tr>`;

    // Từng nhân viên trong nhóm
    grp.employees.forEach(emp => {
      html += `<tr>
        <td class="col-sticky-stt text-muted small">${globalStt++}</td>
        <td class="col-sticky-code font-monospace fw-bold text-primary">${emp.employee_code}</td>
        <td class="col-sticky-name fw-semibold">
          <div class="d-flex align-items-center justify-content-between gap-1">
            <span class="text-truncate" title="${emp.full_name}">${emp.full_name}</span>
            <button type="button" class="btn btn-link btn-xs p-0 text-muted opacity-75 hover-primary" title="Điều chỉnh nhóm làm việc" onclick="quickChangeWorkGroup('${emp.employee_code}', '${grp.group_name.replace(/'/g, "\\'")}', '${emp.full_name.replace(/'/g, "\\'")}')">
              <span class="material-icons" style="font-size: 14px;">swap_horiz</span>
            </button>
          </div>
        </td>`;

      for (let d = 1; d <= daysInMonth; d++) {
        const cell = emp.days[d];
        const isSunday = cell.is_sunday;
        const isToday = cell.is_today;
        let cellContent = '';

        if (cell.state === 'actual') {
          cellContent = `<div class="leave-cell-box sq-green" data-tt="${encodeURIComponent(JSON.stringify(cell))}" data-emp="${encodeURIComponent(emp.full_name)} (${emp.employee_code})">TT</div>`;
        } else if (cell.state === 'plan') {
          cellContent = `<div class="leave-cell-box sq-yellow" data-tt="${encodeURIComponent(JSON.stringify(cell))}" data-emp="${encodeURIComponent(emp.full_name)} (${emp.employee_code})">KH</div>`;
        } else if (cell.state === 'both') {
          cellContent = `<div class="leave-cell-box sq-blue" data-tt="${encodeURIComponent(JSON.stringify(cell))}" data-emp="${encodeURIComponent(emp.full_name)} (${emp.employee_code})">K+T</div>`;
        } else if (cell.state === 'plan_missed') {
          cellContent = `<div class="leave-cell-box sq-dashed" data-tt="${encodeURIComponent(JSON.stringify(cell))}" data-emp="${encodeURIComponent(emp.full_name)} (${emp.employee_code})" title="Kế hoạch nhưng không có thực tế">--</div>`;
        }

        const tdClass = isToday ? 'col-today' : (isSunday ? 'bg-sunday' : '');
        html += `<td class="day-cell ${tdClass}">${cellContent}</td>`;
      }

      html += `</tr>`;
    });

    // Dòng tổng cộng nhóm (Group Daily Summary)
    html += `<tr class="group-total-row">
      <td class="col-sticky-stt text-muted"></td>
      <td class="col-sticky-code text-muted">Nghỉ:</td>
      <td class="col-sticky-name text-start text-muted">${grp.group_name}</td>`;

    for (let d = 1; d <= daysInMonth; d++) {
      const cnt = grp.daily_stats[d] || 0;
      const displayVal = cnt > 0 ? `<strong class="text-primary">${cnt}</strong>` : '<span class="text-muted opacity-50">-</span>';
      html += `<td class="day-cell">${displayVal}</td>`;
    }
    html += `</tr>`;
  });

  tbody.innerHTML = html;

  // Tooltips
  setupCellTooltips();
}

// 4. Cập nhật Thẻ Thống Kê
function updateTopMetrics(data) {
  document.getElementById('statTotalEmployees').textContent = data.total_employees || 0;
  document.getElementById('statTodayLeaves').textContent = data.today_leaves_count || 0;
  document.getElementById('statActualLeaves').textContent = (data.total_actual_leaves || 0) + ' ngày';
  document.getElementById('statPlannedLeaves').textContent = (data.total_planned_leaves || 0) + ' ngày';
}

// 5. Quản lý Tooltip Hiện Đại
function setupCellTooltips() {
  const tooltip = document.getElementById('customTooltip');
  document.querySelectorAll('.leave-cell-box').forEach(el => {
    el.addEventListener('mouseenter', function(e) {
      try {
        const cell = JSON.parse(decodeURIComponent(this.getAttribute('data-tt')));
        const empName = decodeURIComponent(this.getAttribute('data-emp'));
        const dateParts = cell.date.split('-');
        const dateFormatted = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;

        let stateTitle = '';
        if (cell.state === 'actual') stateTitle = '<span class="text-success fw-bold">● Phép Thực Tế HRM</span>';
        else if (cell.state === 'plan') stateTitle = '<span class="text-warning fw-bold">● Phép Dự Kiến Kế Hoạch</span>';
        else if (cell.state === 'both') stateTitle = '<span class="text-info fw-bold">● Khớp Cả Kế Hoạch & Thực Tế</span>';
        else if (cell.state === 'plan_missed') stateTitle = '<span class="text-secondary fw-bold">● Kế Hoạch Chưa Có Thực Tế</span>';

        tooltip.innerHTML = `
          <div class="tt-title">${empName}</div>
          <div class="tt-row"><span class="tt-label">Ngày:</span> <strong>${dateFormatted} (T${cell.day_of_week === 7 ? 'CN' : cell.day_of_week + 1})</strong></div>
          <div class="tt-row"><span class="tt-label">Loại nghỉ:</span> <strong>${cell.leave_type || 'Phép nghỉ'}</strong></div>
          <div class="tt-row"><span class="tt-label">Buổi:</span> <span>${cell.session || 'Cả ngày'}</span></div>
          ${cell.reason ? `<div class="tt-row"><span class="tt-label">Lý do:</span> <span>${cell.reason}</span></div>` : ''}
          <div class="tt-row mt-2 pt-1 border-top"><span class="tt-label">Nguồn:</span> ${stateTitle}</div>
        `;

        tooltip.style.display = 'block';
        moveTooltip(e);
      } catch (err) {}
    });

    el.addEventListener('mousemove', moveTooltip);

    el.addEventListener('mouseleave', function() {
      tooltip.style.display = 'none';
    });
  });
}

function moveTooltip(e) {
  const tooltip = document.getElementById('customTooltip');
  const pad = 12;
  let x = e.clientX + pad;
  let y = e.clientY + pad;

  if (x + 290 > window.innerWidth) x = e.clientX - 290 - pad;
  if (y + 160 > window.innerHeight) y = e.clientY - 160 - pad;

  tooltip.style.left = x + 'px';
  tooltip.style.top = y + 'px';
}

// 6. Gợi ý tự động (Autocomplete) Nhân Viên Khi Đăng Ký
function handleEmpSearchInput(kw) {
  clearTimeout(empSearchTimeout);
  const box = document.getElementById('empSuggestionBox');
  kw = kw.trim();

  if (kw.length < 1) {
    box.style.display = 'none';
    box.innerHTML = '';
    return;
  }

  empSearchTimeout = setTimeout(() => {
    fetch(`api/hrm_leave.php?action=get_employees&search=${encodeURIComponent(kw)}&limit=25`)
      .then(r => r.json())
      .then(res => {
        if (res.success && res.employees && res.employees.length > 0) {
          currentSearchItems = res.employees;
          focusedSearchIndex = -1;
          renderAutocompleteItems(res.employees, kw);
          box.style.display = 'block';
        } else {
          box.innerHTML = '<div class="p-3 text-center text-muted small">Không tìm thấy nhân viên phù hợp</div>';
          box.style.display = 'block';
        }
      });
  }, 150);
}

function renderAutocompleteItems(items, kw) {
  const box = document.getElementById('empSuggestionBox');
  let html = '';

  items.forEach((e, idx) => {
    let grpBadgeClass = 'badge-wg-khac';
    const gn = (e.work_group || '').toLowerCase();
    if (gn.includes('tu')) grpBadgeClass = 'badge-wg-dun_tu';
    else if (gn.includes('đùn t') || gn.includes('t extrusion')) grpBadgeClass = 'badge-wg-dun_t';
    else if (gn.includes('thiết bị')) grpBadgeClass = 'badge-wg-thiet_bi';
    else if (gn.includes('shotblast') || gn.includes('bắn cát')) grpBadgeClass = 'badge-wg-shotblast';
    else if (gn.includes('nghiền')) grpBadgeClass = 'badge-wg-nghien_nhua';

    // Highlight text
    const re = new RegExp(`(${escapeRegExp(kw)})`, 'gi');
    const hlCode = e.employee_code.replace(re, '<span class="emp-match-hl">$1</span>');
    const hlName = e.full_name.replace(re, '<span class="emp-match-hl">$1</span>');

    html += `
      <div class="autocomplete-item" id="acItem_${idx}" onclick="selectEmployee(${idx})">
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-light text-primary border font-monospace px-2 py-1">${hlCode}</span>
          <div>
            <div class="fw-bold small text-main">${hlName}</div>
            <div class="text-muted" style="font-size:11px;">CC: ${e.cost_center || '-'} ${e.team_name ? '| Tổ: ' + e.team_name : ''}</div>
          </div>
        </div>
        <div>
          <span class="badge-workgroup ${grpBadgeClass}">${e.work_group || 'Khác'}</span>
        </div>
      </div>
    `;
  });

  box.innerHTML = html;
}

function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function handleEmpSearchKeydown(e) {
  const box = document.getElementById('empSuggestionBox');
  if (box.style.display !== 'block' || currentSearchItems.length === 0) return;

  if (e.key === 'ArrowDown') {
    e.preventDefault();
    focusedSearchIndex = Math.min(focusedSearchIndex + 1, currentSearchItems.length - 1);
    highlightFocusedItem();
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    focusedSearchIndex = Math.max(focusedSearchIndex - 1, 0);
    highlightFocusedItem();
  } else if (e.key === 'Enter') {
    e.preventDefault();
    if (focusedSearchIndex >= 0 && focusedSearchIndex < currentSearchItems.length) {
      selectEmployee(focusedSearchIndex);
    }
  } else if (e.key === 'Escape') {
    box.style.display = 'none';
  }
}

function highlightFocusedItem() {
  document.querySelectorAll('.autocomplete-item').forEach((el, idx) => {
    if (idx === focusedSearchIndex) {
      el.classList.add('active');
      el.scrollIntoView({ block: 'nearest' });
    } else {
      el.classList.remove('active');
    }
  });
}

function selectEmployee(idx) {
  const e = currentSearchItems[idx];
  if (!e) return;

  document.getElementById('planEmpCode').value = e.employee_code;
  document.getElementById('planFullName').value = e.full_name;
  document.getElementById('planTeamName').value = e.team_name || e.work_group || '';
  document.getElementById('planEmpSearch').value = `${e.employee_code} - ${e.full_name}`;

  // Tự động gán nhóm làm việc tương ứng
  const wgSelect = document.getElementById('planWorkGroup');
  if (wgSelect) {
    let found = false;
    for (let i = 0; i < wgSelect.options.length; i++) {
      if (wgSelect.options[i].value === e.work_group) {
        wgSelect.selectedIndex = i;
        found = true;
        break;
      }
    }
    if (!found) {
      const opt = document.createElement('option');
      opt.value = e.work_group;
      opt.textContent = e.work_group;
      opt.selected = true;
      wgSelect.appendChild(opt);
    }
  }

  // Hiển thị thẻ xác nhận
  const card = document.getElementById('planSelectedCard');
  card.style.setProperty('display', 'flex', 'important');
  document.getElementById('planSelectedAvatar').textContent = e.full_name.charAt(0);
  document.getElementById('planSelectedName').textContent = `${e.full_name} (${e.employee_code})`;
  document.getElementById('planSelectedSub').textContent = `Nhóm: ${e.work_group || 'Chưa phân nhóm'} | Tổ: ${e.team_name || '-'}`;

  document.getElementById('empSuggestionBox').style.display = 'none';
}

function clearSelectedEmployee() {
  document.getElementById('planEmpCode').value = '';
  document.getElementById('planFullName').value = '';
  document.getElementById('planTeamName').value = '';
  document.getElementById('planEmpSearch').value = '';
  const card = document.getElementById('planSelectedCard');
  card.style.setProperty('display', 'none', 'important');
  document.getElementById('planEmpSearch').focus();
}

function syncEndDate(startVal) {
  const endInput = document.getElementById('planEndDate');
  if (!endInput.value || endInput.value < startVal) {
    endInput.value = startVal;
  }
}

// 7. Modal Đăng Ký Phép Kế Hoạch
function openPlanModal() {
  document.getElementById('formPlanLeave').reset();
  clearSelectedEmployee();
  document.getElementById('planStartDate').value = new Date().toISOString().split('T')[0];
  document.getElementById('planEndDate').value = new Date().toISOString().split('T')[0];
  new bootstrap.Modal(document.getElementById('modalPlanLeave')).show();
}

function submitPlanLeave(e) {
  e.preventDefault();
  const empCode = document.getElementById('planEmpCode').value;
  if (!empCode) {
    alert('Vui lòng chọn nhân viên từ danh sách gợi ý tự động.');
    document.getElementById('planEmpSearch').focus();
    return;
  }

  const form = document.getElementById('formPlanLeave');
  const formData = new FormData(form);
  formData.append('action', 'create_plan');

  const btn = document.getElementById('btnSubmitPlan');
  btn.disabled = true;
  btn.textContent = 'Đang lưu...';

  fetch('api/hrm_leave.php', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(res => {
      btn.disabled = false;
      btn.textContent = 'Gửi Đăng Ký';
      alert(res.message);
      if (res.success) {
        bootstrap.Modal.getInstance(document.getElementById('modalPlanLeave')).hide();
        loadTimelineData();
        loadPlansData(1);
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.textContent = 'Gửi Đăng Ký';
      alert('Lỗi gửi đăng ký: ' + err);
    });
}

// 8. Danh Sách & Phê Duyệt Kế Hoạch (Tab 2)
function loadPlansData(page = 1) {
  currentPlanPage = page;
  const month = document.getElementById('filterMonth').value;
  const year  = document.getElementById('filterYear').value;
  const status = document.getElementById('planStatusFilter').value;
  const search = document.getElementById('planSearchInput').value.trim();

  const tbody = document.getElementById('plansTbody');
  tbody.innerHTML = `<tr><td colspan="12" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>Đang tải danh sách phép...</div></td></tr>`;

  fetch(`api/hrm_leave.php?action=get_plans&month=${month}&year=${year}&status=${status}&search=${encodeURIComponent(search)}&page=${page}&limit=25`)
    .then(r => r.json())
    .then(res => {
      if (!res.success) {
        tbody.innerHTML = `<tr><td colspan="12" class="text-center py-4 text-danger">${res.message || 'Lỗi tải dữ liệu'}</td></tr>`;
        return;
      }
      renderPlansTable(res.data, res.pagination);
    })
    .catch(err => {
      tbody.innerHTML = `<tr><td colspan="12" class="text-center py-4 text-danger">Lỗi: ${err}</td></tr>`;
    });
}

function renderPlansTable(list, pagination) {
  const tbody = document.getElementById('plansTbody');
  if (!list || list.length === 0) {
    tbody.innerHTML = `<tr><td colspan="12" class="text-center py-4 text-muted">Không có đơn phép nào</td></tr>`;
    document.getElementById('plansPageInfo').textContent = 'Hiển thị 0 dòng';
    document.getElementById('plansPageBtns').innerHTML = '';
    return;
  }

  let html = '';
  let pendingCount = 0;
  selectedPlanIds = [];
  document.getElementById('checkAllPlans').checked = false;
  document.getElementById('btnBulkApprove').style.display = 'none';

  list.forEach((item, idx) => {
    if (item.status === 'pending') pendingCount++;

    let statusBadge = '';
    if (item.status === 'approved') statusBadge = '<span class="badge-status badge-approved"><span class="material-icons" style="font-size:14px;">check</span> Đã duyệt</span>';
    else if (item.status === 'rejected') statusBadge = '<span class="badge-status badge-rejected"><span class="material-icons" style="font-size:14px;">close</span> Từ chối</span>';
    else statusBadge = '<span class="badge-status badge-pending"><span class="material-icons" style="font-size:14px;">hourglass_empty</span> Chờ duyệt</span>';

    const sessionText = item.session_type === 'all_day' ? 'Cả ngày' : (item.session_type === 'morning' ? 'Sáng' : 'Chiều');
    const dateFormatted = item.leave_date.split('-').reverse().join('/');
    const workGroupDisplay = item.work_group || item.team_name || 'Khác';

    html += `<tr>
      <td style="text-align: center;">
        ${item.status === 'pending' ? `<input type="checkbox" class="plan-checkbox" value="${item.id}" onchange="handlePlanCheck(this)">` : ''}
      </td>
      <td style="text-align: center;" class="text-muted small">${(pagination.current_page - 1) * pagination.limit + idx + 1}</td>
      <td class="font-monospace fw-bold text-primary">${item.employee_code}</td>
      <td class="fw-semibold">${item.full_name}</td>
      <td>
        <button type="button" class="badge bg-light text-primary border d-inline-flex align-items-center gap-1 cursor-pointer" style="border: 1px solid var(--dx-border) !important; background: var(--dx-bg-subtle) !important;" title="Bấm để điều chỉnh nhóm làm việc" onclick="quickChangeWorkGroup('${item.employee_code}', '${workGroupDisplay.replace(/'/g, "\\'")}', '${item.full_name.replace(/'/g, "\\'")}')">
          <span>${workGroupDisplay}</span>
          <span class="material-icons" style="font-size:12px;">edit</span>
        </button>
      </td>
      <td style="text-align: center;" class="fw-bold">${dateFormatted}</td>
      <td style="text-align: center;"><span class="badge bg-light text-dark">${sessionText}</span></td>
      <td>${item.leave_type}</td>
      <td class="small text-muted">${item.reason || '-'}</td>
      <td style="text-align: center;">${statusBadge}</td>
      <td class="small text-muted">${item.approved_by ? `${item.approved_by}` : '-'}</td>
      <td style="text-align: center;">
        <div class="d-flex align-items-center justify-content-center gap-1">
          <button class="app-btn app-btn-outline app-btn-xs text-primary" type="button" onclick="quickChangeWorkGroup('${item.employee_code}', '${workGroupDisplay.replace(/'/g, "\\'")}', '${item.full_name.replace(/'/g, "\\'")}')" title="Phân bổ lại nhóm làm việc">
            <span class="material-icons" style="font-size:14px;">swap_horiz</span>
          </button>
          ${item.status === 'pending' ? `
            <button class="app-btn app-btn-success app-btn-xs" type="button" onclick="approvePlan(${item.id})" title="Phê duyệt">
              <span class="material-icons" style="font-size:14px;">done</span>
            </button>
            <button class="app-btn app-btn-danger app-btn-xs" type="button" onclick="openRejectModal(${item.id})" title="Từ chối">
              <span class="material-icons" style="font-size:14px;">close</span>
            </button>
          ` : ''}
          <button class="app-btn app-btn-outline app-btn-xs text-danger" type="button" onclick="deletePlan(${item.id})" title="Xóa">
            <span class="material-icons" style="font-size:14px;">delete</span>
          </button>
        </div>
      </td>
    </tr>`;
  });

  tbody.innerHTML = html;
  document.getElementById('badgePendingCount').textContent = `${pendingCount} chờ duyệt`;
  renderPagination(pagination);
}

function renderPagination(p) {
  const info = document.getElementById('plansPageInfo');
  const btns = document.getElementById('plansPageBtns');

  info.textContent = `Trang ${p.current_page} / ${p.total_pages || 1} (Tổng ${p.total_rows} bản ghi)`;

  let btnHtml = '';
  if (p.current_page > 1) {
    btnHtml += `<button class="app-btn app-btn-outline app-btn-xs" onclick="loadPlansData(${p.current_page - 1})"><span class="material-icons">chevron_left</span></button>`;
  }
  for (let i = Math.max(1, p.current_page - 2); i <= Math.min(p.total_pages, p.current_page + 2); i++) {
    const active = (i === p.current_page) ? 'app-btn-primary' : 'app-btn-outline';
    btnHtml += `<button class="app-btn ${active} app-btn-xs" onclick="loadPlansData(${i})">${i}</button>`;
  }
  if (p.current_page < p.total_pages) {
    btnHtml += `<button class="app-btn app-btn-outline app-btn-xs" onclick="loadPlansData(${p.current_page + 1})"><span class="material-icons">chevron_right</span></button>`;
  }
  btns.innerHTML = btnHtml;
}

// Xử lý Checkbox Bulk
function handlePlanCheck(el) {
  const id = parseInt(el.value);
  if (el.checked) {
    if (!selectedPlanIds.includes(id)) selectedPlanIds.push(id);
  } else {
    selectedPlanIds = selectedPlanIds.filter(x => x !== id);
  }
  updateBulkButton();
}

function toggleSelectAllPlans(master) {
  document.querySelectorAll('.plan-checkbox').forEach(cb => {
    cb.checked = master.checked;
    const id = parseInt(cb.value);
    if (master.checked) {
      if (!selectedPlanIds.includes(id)) selectedPlanIds.push(id);
    } else {
      selectedPlanIds = [];
    }
  });
  updateBulkButton();
}

function updateBulkButton() {
  const btn = document.getElementById('btnBulkApprove');
  const txt = document.getElementById('bulkApproveText');
  if (selectedPlanIds.length > 0) {
    btn.style.display = 'inline-flex';
    txt.textContent = `Duyệt (${selectedPlanIds.length}) đơn`;
  } else {
    btn.style.display = 'none';
  }
}

function approvePlan(id) {
  if (!confirm('Bạn có chắc chắn muốn phê duyệt đơn phép này?')) return;
  const formData = new FormData();
  formData.append('action', 'approve_plan');
  formData.append('plan_id', id);

  fetch('api/hrm_leave.php', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(res => {
      alert(res.message);
      if (res.success) {
        loadPlansData(currentPlanPage);
        loadTimelineData();
      }
    });
}

function bulkApprovePlans() {
  if (selectedPlanIds.length === 0) return;
  if (!confirm(`Bạn có chắc muốn phê duyệt đồng loạt ${selectedPlanIds.length} đơn đã chọn?`)) return;

  const formData = new FormData();
  formData.append('action', 'approve_plan');
  selectedPlanIds.forEach(id => formData.append('plan_ids[]', id));

  fetch('api/hrm_leave.php', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(res => {
      alert(res.message);
      if (res.success) {
        loadPlansData(currentPlanPage);
        loadTimelineData();
      }
    });
}

function openRejectModal(id) {
  document.getElementById('rejectPlanId').value = id;
  document.getElementById('rejectReason').value = '';
  new bootstrap.Modal(document.getElementById('modalRejectLeave')).show();
}

function submitRejectLeave(e) {
  e.preventDefault();
  const id = document.getElementById('rejectPlanId').value;
  const reason = document.getElementById('rejectReason').value.trim();

  const formData = new FormData();
  formData.append('action', 'reject_plan');
  formData.append('plan_id', id);
  formData.append('reason', reason);

  fetch('api/hrm_leave.php', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(res => {
      alert(res.message);
      if (res.success) {
        bootstrap.Modal.getInstance(document.getElementById('modalRejectLeave')).hide();
        loadPlansData(currentPlanPage);
        loadTimelineData();
      }
    });
}

function deletePlan(id) {
  if (!confirm('Bạn có chắc chắn muốn xóa bản ghi kế hoạch này?')) return;
  const formData = new FormData();
  formData.append('action', 'delete_plan');
  formData.append('plan_id', id);

  fetch('api/hrm_leave.php', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(res => {
      alert(res.message);
      if (res.success) {
        loadPlansData(currentPlanPage);
        loadTimelineData();
      }
    });
}

// 9. Tự Động Đồng Bộ HRM & File Excel (Tab 3)
function loadSyncConfig() {
  fetch('api/hrm_leave_sync.php?action=get_config')
    .then(r => r.json())
    .then(res => {
      if (res.success && res.config) {
        const c = res.config;
        document.getElementById('lastSyncTime').textContent = c.last_sync_time || 'Chưa từng đồng bộ';
        document.getElementById('lastSyncMsg').textContent = c.last_sync_message || '-';
        if (c.sync_date_from) document.getElementById('syncDateFrom').value = c.sync_date_from;
        if (c.sync_date_to) document.getElementById('syncDateTo').value = c.sync_date_to;

        // Custom endpoints & params
        if (document.getElementById('cfgHrmUrl')) document.getElementById('cfgHrmUrl').value = c.hrm_url || 'https://hrm.smcmfg.com.vn';
        if (document.getElementById('cfgLoginEndpoint')) document.getElementById('cfgLoginEndpoint').value = c.login_endpoint || 'https://hrm.smcmfg.com.vn/login';
        if (document.getElementById('cfgAuthEndpoint')) document.getElementById('cfgAuthEndpoint').value = c.auth_endpoint || 'https://hrm.smcmfg.com.vn/Account/GetLogin_KiemTraLoginLanDau';
        if (document.getElementById('cfgPortalEndpoint')) document.getElementById('cfgPortalEndpoint').value = c.portal_endpoint || 'https://hrm.smcmfg.com.vn/NghiPhep/DuyetPhep';
        if (document.getElementById('cfgExportEndpoint')) document.getElementById('cfgExportEndpoint').value = c.export_endpoint || 'https://hrm.smcmfg.com.vn/Portal/NghiPhep/ExportDeDuyetNghiPhep';
        if (document.getElementById('cfgDownloadEndpoint')) document.getElementById('cfgDownloadEndpoint').value = c.download_endpoint || 'https://hrm.smcmfg.com.vn/Download/ExcelDownload';
        if (document.getElementById('cfgSyncInterval')) document.getElementById('cfgSyncInterval').value = c.sync_interval_hours || 3;
        if (document.getElementById('cfgAutoSync')) document.getElementById('cfgAutoSync').checked = (c.auto_sync_enabled !== false);
      }
    });
}

function saveHrmConfig(e) {
  e.preventDefault();
  const btn = document.getElementById('btnSaveHrmConfig');
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...`;

  const form = document.getElementById('formHrmConfig');
  const fd = new FormData(form);
  fd.append('action', 'save_config');
  fd.set('auto_sync_enabled', document.getElementById('cfgAutoSync').checked ? '1' : '0');

  fetch('api/hrm_leave_sync.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      btn.disabled = false;
      btn.innerHTML = `<span class="material-icons">save</span> <span>Lưu Cấu Hình Kết Nối</span>`;
      alert(res.message);
      if (res.success) {
        logTerminal('Đã lưu cấu hình kết nối HRM tùy chỉnh.', 'success');
        loadSyncConfig();
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.innerHTML = `<span class="material-icons">save</span> <span>Lưu Cấu Hình Kết Nối</span>`;
      alert('Lỗi lưu cấu hình: ' + err);
    });
}

function resetHrmConfigToDefault() {
  if (!confirm('Khôi phục các URL và tham số kết nối về giá trị mặc định chuẩn của HRM SMC?')) return;
  document.getElementById('cfgHrmUrl').value = 'https://hrm.smcmfg.com.vn';
  document.getElementById('cfgLoginEndpoint').value = 'https://hrm.smcmfg.com.vn/login';
  document.getElementById('cfgAuthEndpoint').value = 'https://hrm.smcmfg.com.vn/Account/GetLogin_KiemTraLoginLanDau';
  document.getElementById('cfgPortalEndpoint').value = 'https://hrm.smcmfg.com.vn/NghiPhep/DuyetPhep';
  document.getElementById('cfgExportEndpoint').value = 'https://hrm.smcmfg.com.vn/Portal/NghiPhep/ExportDeDuyetNghiPhep';
  document.getElementById('cfgDownloadEndpoint').value = 'https://hrm.smcmfg.com.vn/Download/ExcelDownload';
  document.getElementById('cfgSyncInterval').value = '3';
  document.getElementById('cfgAutoSync').checked = true;
}

function loadHrmAccounts() {
  const tbody = document.getElementById('hrmAccountsTbody');
  if (!tbody) return;

  fetch('api/hrm_leave_sync.php?action=get_accounts')
    .then(r => r.json())
    .then(res => {
      if (!res.success || !res.accounts || res.accounts.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted">Chưa có tài khoản HRM nào. Vui lòng bấm "Thêm tài khoản".</td></tr>`;
        return;
      }

      let html = '';
      res.accounts.forEach(a => {
        const isActive = (a.is_active == 1);
        const statusBadge = isActive
          ? `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><span class="material-icons align-middle" style="font-size:12px;">check_circle</span> Hoạt động</span>`
          : `<span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><span class="material-icons align-middle" style="font-size:12px;">pause</span> Tắt</span>`;

        const safeName = escapeHtml(a.account_name || ('Tài khoản ' + a.username));
        const safeUser = escapeHtml(a.username);

        html += `
          <tr>
            <td style="text-align:center;" class="text-muted small">${a.id}</td>
            <td>
              <div class="fw-bold text-main">${safeName}</div>
              <div class="text-muted" style="font-size:11px;">Lần cuối: ${a.last_sync_time || 'Chưa chạy'}</div>
            </td>
            <td><code class="fw-bold text-primary font-monospace">${safeUser}</code></td>
            <td style="text-align:center;">${statusBadge}</td>
            <td style="text-align:center;">
              <div class="d-flex align-items-center justify-content-center gap-1">
                <button class="app-btn app-btn-outline app-btn-xs text-info" type="button" onclick="testHrmAccount(${a.id}, '${safeUser.replace(/'/g, "\\'")}')" title="Kiểm tra kết nối & lấy token">
                  <span class="material-icons" style="font-size:14px;">network_check</span>
                </button>
                <button class="app-btn app-btn-outline app-btn-xs text-primary" type="button" onclick="openHrmAccountModal(${a.id}, '${safeName.replace(/'/g, "\\'")}', '${safeUser.replace(/'/g, "\\'")}', ${a.is_active})" title="Sửa">
                  <span class="material-icons" style="font-size:14px;">edit</span>
                </button>
                <button class="app-btn app-btn-outline app-btn-xs text-danger" type="button" onclick="deleteHrmAccount(${a.id}, '${safeUser.replace(/'/g, "\\'")}')" title="Xóa">
                  <span class="material-icons" style="font-size:14px;">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    })
    .catch(err => {
      tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-danger">Lỗi tải tài khoản: ${err}</td></tr>`;
    });
}

function openHrmAccountModal(id = 0, name = '', username = '', isActive = 1) {
  document.getElementById('accFormId').value = id;
  document.getElementById('accFormName').value = name;
  document.getElementById('accFormUser').value = username;
  document.getElementById('accFormPass').value = '';
  document.getElementById('accFormActive').checked = (isActive == 1);

  if (id > 0) {
    document.getElementById('hrmAccountModalTitle').textContent = `Sửa Tài Khoản HRM [${username}]`;
    document.getElementById('accPassRequired').style.display = 'none';
    document.getElementById('accPassHelp').style.display = 'block';
    document.getElementById('accFormPass').required = false;
  } else {
    document.getElementById('hrmAccountModalTitle').textContent = 'Thêm Tài Khoản HRM';
    document.getElementById('accPassRequired').style.display = 'inline';
    document.getElementById('accPassHelp').style.display = 'none';
    document.getElementById('accFormPass').required = true;
  }

  const modalEl = document.getElementById('modalHrmAccount');
  let modalInstance = bootstrap.Modal.getInstance(modalEl);
  if (!modalInstance) {
    modalInstance = new bootstrap.Modal(modalEl);
  }
  modalInstance.show();
}

function submitHrmAccount(e) {
  e.preventDefault();
  const btn = document.getElementById('btnSubmitHrmAccount');
  btn.disabled = true;
  btn.textContent = 'Đang lưu...';

  const fd = new FormData(document.getElementById('formHrmAccount'));
  fd.append('action', 'save_account');
  fd.set('is_active', document.getElementById('accFormActive').checked ? '1' : '0');

  fetch('api/hrm_leave_sync.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      btn.disabled = false;
      btn.textContent = 'Lưu Tài Khoản';
      alert(res.message);
      if (res.success) {
        const modalEl = document.getElementById('modalHrmAccount');
        const inst = bootstrap.Modal.getInstance(modalEl);
        if (inst) inst.hide();
        loadHrmAccounts();
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.textContent = 'Lưu Tài Khoản';
      alert('Lỗi: ' + err);
    });
}

function deleteHrmAccount(id, username) {
  if (!confirm(`Bạn có chắc chắn muốn xóa tài khoản HRM [${username}]?`)) return;

  const fd = new FormData();
  fd.append('action', 'delete_account');
  fd.append('id', id);

  fetch('api/hrm_leave_sync.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      alert(res.message);
      if (res.success) {
        loadHrmAccounts();
      }
    });
}

function testHrmAccount(id, username) {
  logTerminal(`--- BẮT ĐẦU KIỂM TRA KẾT NỐI TÀI KHOẢN [${username}] ---`, 'info');
  logTerminal(`Đang thực hiện quy trình đăng nhập, trích xuất Token và gọi Endpoint HRM...`, 'info');

  const fd = new FormData();
  fd.append('action', 'test_connection');
  fd.append('account_id', id);

  if (document.getElementById('cfgLoginEndpoint')) fd.append('login_endpoint', document.getElementById('cfgLoginEndpoint').value);
  if (document.getElementById('cfgAuthEndpoint')) fd.append('auth_endpoint', document.getElementById('cfgAuthEndpoint').value);
  if (document.getElementById('cfgPortalEndpoint')) fd.append('portal_endpoint', document.getElementById('cfgPortalEndpoint').value);
  if (document.getElementById('cfgExportEndpoint')) fd.append('export_endpoint', document.getElementById('cfgExportEndpoint').value);
  if (document.getElementById('cfgDownloadEndpoint')) fd.append('download_endpoint', document.getElementById('cfgDownloadEndpoint').value);

  fetch('api/hrm_leave_sync.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      if (res.steps && res.steps.length > 0) {
        res.steps.forEach(st => {
          const type = (st.status === 'success') ? 'success' : ((st.status === 'error') ? 'error' : 'warning');
          logTerminal(`[${st.account}] ${st.title} (${st.method} ${st.http_code ? st.http_code : ''}): ${st.detail}`, type);
        });
      }

      if (res.urls_called && res.urls_called.length > 0) {
        logTerminal(`CÁC URL HRM ĐÃ GỌI:`, 'info');
        res.urls_called.forEach(u => logTerminal(`→ ${u}`, 'url'));
      }

      if (res.success) {
        logTerminal(`KẾT QUẢ: ${res.message}`, 'success');
        if (res.stats) {
          logTerminal(`Dữ liệu thực tế: ${res.stats.updated || 0} bản ghi cập nhật, ${res.stats.inserted || 0} bản ghi thêm mới.`, 'success');
        }
        alert(res.message);
        loadTimelineData();
      } else {
        logTerminal(`KẾT QUẢ THẤT BẠI: ${res.message}`, 'error');
        alert(res.message);
      }
    })
    .catch(err => {
      logTerminal(`Lỗi gọi API: ${err}`, 'error');
      alert('Lỗi kiểm tra kết nối: ' + err);
    });
}

function triggerHrmSync() {
  const btn = document.getElementById('btnTriggerSync');
  const dFrom = document.getElementById('syncDateFrom').value;
  const dTo = document.getElementById('syncDateTo').value;

  btn.disabled = true;
  btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang đồng bộ...`;

  logTerminal(`Bắt đầu đồng bộ phép nghỉ từ ngày ${dFrom} đến ngày ${dTo}...`, 'info');
  logTerminal(`Đang gửi yêu cầu POST đến /Portal/NghiPhep/ExportDeDuyetNghiPhep...`, 'info');

  const fd = new FormData();
  fd.append('action', 'trigger_sync');
  fd.append('date_from', dFrom);
  fd.append('date_to', dTo);

  fetch('api/hrm_leave_sync.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      btn.disabled = false;
      btn.innerHTML = `<span class="material-icons">sync</span> <span>Bắt đầu Đồng Bộ HRM Ngay</span>`;

      if (res.steps && res.steps.length > 0) {
        res.steps.forEach(st => {
          const type = (st.status === 'success') ? 'success' : ((st.status === 'error') ? 'error' : 'warning');
          logTerminal(`[${st.account}] ${st.title} (${st.method} ${st.http_code ? st.http_code : ''}): ${st.detail}`, type);
        });
      }

      if (res.urls_called && res.urls_called.length > 0) {
        logTerminal(`--- CÁC ENDPOINT ĐÃ GỌI RA MÁY CHỦ HRM ---`, 'info');
        res.urls_called.forEach(u => {
          logTerminal(`→ ${u}`, 'url');
        });
      }

      if (res.success) {
        logTerminal(`KẾT QUẢ: ${res.message}`, 'success');
        alert(res.message);
        loadSyncConfig();
        loadTimelineData();
      } else {
        logTerminal(`THẤT BẠI: ${res.message}`, 'error');
        alert(res.message);
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.innerHTML = `<span class="material-icons">sync</span> <span>Bắt đầu Đồng Bộ HRM Ngay</span>`;
      logTerminal(`Lỗi gọi API: ${err}`, 'error');
      alert('Lỗi kết nối: ' + err);
    });
}

function handleManualExcelUpload(e) {
  e.preventDefault();
  const fileInput = document.getElementById('manualExcelFile');
  if (!fileInput.files || fileInput.files.length === 0) {
    alert('Vui lòng chọn file Excel.');
    return;
  }

  const btn = document.getElementById('btnUploadExcel');
  const alertBox = document.getElementById('uploadResultAlert');
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang nạp dữ liệu...`;

  const fd = new FormData();
  fd.append('action', 'upload_excel');
  fd.append('excel_file', fileInput.files[0]);

  fetch('api/hrm_leave_sync.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      btn.disabled = false;
      btn.innerHTML = `<span class="material-icons">upload</span> <span>Bắt Đầu Nạp Dữ Liệu Excel</span>`;
      alertBox.style.display = 'block';

      if (res.success) {
        alertBox.className = 'alert alert-success small mt-3';
        alertBox.textContent = res.message;
        document.getElementById('excelUploadForm').reset();
        loadSyncConfig();
        loadTimelineData();
      } else {
        alertBox.className = 'alert alert-danger small mt-3';
        alertBox.textContent = res.message;
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.innerHTML = `<span class="material-icons">upload</span> <span>Bắt Đầu Nạp Dữ Liệu Excel</span>`;
      alertBox.style.display = 'block';
      alertBox.className = 'alert alert-danger small mt-3';
      alertBox.textContent = 'Lỗi tải lên: ' + err;
    });
}

function logTerminal(msg, type = 'info') {
  const terminal = document.getElementById('syncTerminal');
  const line = document.createElement('div');
  line.className = 'log-line';

  const now = new Date();
  const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;

  let cls = '';
  if (type === 'success') cls = 'log-success';
  else if (type === 'warning') cls = 'log-warning';
  else if (type === 'error') cls = 'log-error';
  else if (type === 'url') cls = 'log-url';

  line.innerHTML = `<span class="log-time">[${timeStr}]</span> <span class="${cls}">${msg}</span>`;
  terminal.appendChild(line);
  terminal.scrollTop = terminal.scrollHeight;
}

function clearSyncTerminal() {
  document.getElementById('syncTerminal').innerHTML = '';
}

// ==========================================
// 10. MA TRẬN PHÂN BỔ NHÓM LÀM VIỆC (KANBAN CARDS)
// ==========================================
function openWorkGroupMatrixModal() {
  document.getElementById('matrixEmpSearch').value = '';
  matrixSelectedCodes = [];
  updateMatrixSelectedCount();

  const modalEl = document.getElementById('modalWorkGroupMatrix');
  let modalInstance = bootstrap.Modal.getInstance(modalEl);
  if (!modalInstance) {
    modalInstance = new bootstrap.Modal(modalEl);
  }
  modalInstance.show();
  loadWorkGroupMatrixData();
}

function loadWorkGroupMatrixData() {
  const container = document.getElementById('matrixBoardContainer');
  container.innerHTML = `
    <div class="text-center py-5 text-muted w-100">
      <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
      <div>Đang tải ma trận phân bổ...</div>
    </div>`;

  fetch('api/hrm_leave.php?action=get_group_allocations')
    .then(r => r.json())
    .then(res => {
      if (!res.success) {
        container.innerHTML = `<div class="alert alert-danger w-100">${res.message || 'Lỗi tải ma trận'}</div>`;
        return;
      }
      matrixAllocations = res.groups || [];
      document.getElementById('matrixTotalEmpsBadge').textContent = `${res.total_employees || 0} nhân sự`;
      renderWorkGroupMatrixBoard(matrixAllocations);
    })
    .catch(err => {
      container.innerHTML = `<div class="alert alert-danger w-100">Lỗi kết nối máy chủ: ${err}</div>`;
    });
}

function renderWorkGroupMatrixBoard(groups) {
  const container = document.getElementById('matrixBoardContainer');
  if (!groups || groups.length === 0) {
    container.innerHTML = `<div class="text-center py-5 text-muted w-100">Không có dữ liệu nhóm</div>`;
    return;
  }

  let html = '';
  groups.forEach(g => {
    let grpBadgeClass = 'badge-wg-khac';
    const gn = (g.group_name || '').toLowerCase();
    if (gn.includes('tu')) grpBadgeClass = 'badge-wg-dun_tu';
    else if (gn.includes('đùn t') || gn.includes('t extrusion')) grpBadgeClass = 'badge-wg-dun_t';
    else if (gn.includes('thiết bị')) grpBadgeClass = 'badge-wg-thiet_bi';
    else if (gn.includes('shotblast') || gn.includes('bắn cát')) grpBadgeClass = 'badge-wg-shotblast';
    else if (gn.includes('nghiền')) grpBadgeClass = 'badge-wg-nghien_nhua';

    const safeGroupName = escapeHtml(g.group_name);
    const safeAttrGroup = safeGroupName.replace(/"/g, '&quot;');
    const color = g.color_code || '#64748b';

    html += `
      <div class="workgroup-column" data-group-name="${safeAttrGroup}" ondragover="handleMatrixColDragOver(event)" ondragleave="handleMatrixColDragLeave(event)" ondrop="handleMatrixColDrop(event, '${safeGroupName.replace(/'/g, "\\'")}')">
        <div class="workgroup-col-header" style="border-bottom-color: ${color}; color: ${color}; background: rgba(0,0,0,0.02);">
          <div class="d-flex align-items-center gap-2">
            <span class="material-icons" style="font-size: 18px;">view_week</span>
            <span class="wg-header-title">${safeGroupName}</span>
          </div>
          <div class="d-flex align-items-center gap-1">
            <span class="badge rounded-pill bg-light text-dark border fw-bold grp-count-badge" id="badgeCount_${sanitizeId(g.group_name)}">${g.count} NV</span>
          </div>
        </div>
        <div class="workgroup-col-body" id="colBody_${sanitizeId(g.group_name)}">
    `;

    if (!g.employees || g.employees.length === 0) {
      html += `<div class="text-center py-4 text-muted small empty-col-msg">Kéo thả nhân sự vào đây</div>`;
    } else {
      g.employees.forEach(e => {
        const isSelected = matrixSelectedCodes.includes(e.employee_code);
        const safeName = escapeHtml(e.full_name);
        const safeCode = escapeHtml(e.employee_code);

        html += `
          <div class="emp-matrix-card" id="matrixCard_${safeCode}" draggable="true" 
               ondragstart="handleMatrixCardDragStart(event, '${safeCode}', '${safeGroupName.replace(/'/g, "\\'")}')" 
               ondragend="handleMatrixCardDragEnd(event)" 
               data-code="${safeCode.toLowerCase()}" 
               data-name="${safeName.toLowerCase()}" 
               data-group="${safeGroupName}">
            <div class="d-flex align-items-center justify-content-between gap-1">
              <div class="d-flex align-items-center gap-2">
                <input class="form-check-input matrix-card-chk m-0" type="checkbox" value="${safeCode}" onchange="toggleMatrixCardSelect(this, '${safeCode}')" ${isSelected ? 'checked' : ''}>
                <span class="emp-code-badge">${safeCode}</span>
              </div>
              <button class="btn btn-link btn-xs p-0 text-muted hover-primary" type="button" onclick="quickChangeWorkGroup('${safeCode}', '${safeGroupName.replace(/'/g, "\\'")}', '${safeName.replace(/'/g, "\\'")}')" title="Chuyển sang nhóm khác">
                <span class="material-icons" style="font-size: 15px;">swap_horiz</span>
              </button>
            </div>
            <div class="fw-bold small text-main mt-1 emp-card-name">${safeName}</div>
            <div class="cost-center-badge mt-1 d-flex align-items-center justify-content-between">
              <span>CC: ${escapeHtml(e.cost_center || '-')}</span>
              <span class="text-muted" style="font-size:10px;"><span class="material-icons align-middle" style="font-size:11px;">drag_indicator</span> Kéo thẻ</span>
            </div>
          </div>
        `;
      });
    }

    html += `
        </div>
      </div>
    `;
  });

  container.innerHTML = html;
}

function handleMatrixCardDragStart(e, code, fromGroup) {
  draggedEmpCode = code;
  draggedFromGroup = fromGroup;
  e.dataTransfer.setData('text/plain', code);
  e.dataTransfer.effectAllowed = 'move';
  e.currentTarget.classList.add('dragging');
}

function handleMatrixCardDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
  document.querySelectorAll('.workgroup-column').forEach(c => c.classList.remove('drag-over'));
  draggedEmpCode = null;
  draggedFromGroup = null;
}

function handleMatrixColDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  const col = e.currentTarget;
  if (!col.classList.contains('drag-over')) {
    col.classList.add('drag-over');
  }
}

function handleMatrixColDragLeave(e) {
  const col = e.currentTarget;
  if (!col.contains(e.relatedTarget)) {
    col.classList.remove('drag-over');
  }
}

function handleMatrixColDrop(e, targetGroupName) {
  e.preventDefault();
  const col = e.currentTarget;
  col.classList.remove('drag-over');

  const empCode = draggedEmpCode || e.dataTransfer.getData('text/plain');
  if (!empCode) return;

  if (draggedFromGroup === targetGroupName) {
    return;
  }

  updateEmployeeWorkGroup(empCode, targetGroupName);
}

function updateEmployeeWorkGroup(target, newGroup) {
  const fd = new FormData();
  fd.append('action', 'update_employee_work_group');
  fd.append('work_group', newGroup);

  if (Array.isArray(target)) {
    target.forEach(c => fd.append('employee_codes[]', c));
  } else {
    fd.append('employee_code', target);
  }

  fetch('api/hrm_leave.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      if (res.success) {
        loadWorkGroupMatrixData();
        loadTimelineData();
        if (document.getElementById('tabContentPlans').style.display !== 'none') {
          loadPlansData(currentPlanPage);
        }
      } else {
        alert(res.message || 'Lỗi cập nhật nhóm');
      }
    })
    .catch(err => {
      alert('Lỗi kết nối: ' + err);
    });
}

function toggleMatrixCardSelect(cb, code) {
  if (cb.checked) {
    if (!matrixSelectedCodes.includes(code)) matrixSelectedCodes.push(code);
  } else {
    matrixSelectedCodes = matrixSelectedCodes.filter(c => c !== code);
  }
  updateMatrixSelectedCount();
}

function updateMatrixSelectedCount() {
  const el = document.getElementById('matrixSelectedCount');
  if (el) el.textContent = `Đã chọn: ${matrixSelectedCodes.length} NV`;
}

function submitBulkMatrixMove() {
  const targetGroup = document.getElementById('matrixBulkTargetGroup').value;
  if (!targetGroup) {
    alert('Vui lòng chọn nhóm làm việc cần chuyển đến.');
    document.getElementById('matrixBulkTargetGroup').focus();
    return;
  }
  if (matrixSelectedCodes.length === 0) {
    alert('Vui lòng tích chọn ít nhất một nhân viên qua checkbox trên thẻ.');
    return;
  }

  if (!confirm(`Bạn có chắc chắn muốn chuyển ${matrixSelectedCodes.length} nhân sự đã chọn sang nhóm [${targetGroup}]?`)) {
    return;
  }

  const codes = [...matrixSelectedCodes];
  updateEmployeeWorkGroup(codes, targetGroup);
  matrixSelectedCodes = [];
  updateMatrixSelectedCount();
}

function filterMatrixCards(kw) {
  kw = (kw || '').trim().toLowerCase();
  const columns = document.querySelectorAll('.workgroup-column');

  columns.forEach(col => {
    const cards = col.querySelectorAll('.emp-matrix-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const code = card.getAttribute('data-code') || '';
      const name = card.getAttribute('data-name') || '';

      if (!kw || code.includes(kw) || name.includes(kw)) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const badge = col.querySelector('.grp-count-badge');
    if (badge) {
      badge.textContent = `${visibleCount} NV`;
    }
  });
}

function quickChangeWorkGroup(empCode, currentGroup, empName) {
  document.getElementById('quickEmpCode').value = empCode;
  document.getElementById('quickEmpName').textContent = `${empName} (${empCode})`;

  const sel = document.getElementById('quickNewGroup');
  if (sel) {
    let found = false;
    for (let i = 0; i < sel.options.length; i++) {
      if (sel.options[i].value === currentGroup) {
        sel.selectedIndex = i;
        found = true;
        break;
      }
    }
    if (!found && currentGroup) {
      const opt = document.createElement('option');
      opt.value = currentGroup;
      opt.textContent = currentGroup;
      opt.selected = true;
      sel.appendChild(opt);
    }
  }

  const modalEl = document.getElementById('modalQuickChangeGroup');
  let modalInstance = bootstrap.Modal.getInstance(modalEl);
  if (!modalInstance) {
    modalInstance = new bootstrap.Modal(modalEl);
  }
  modalInstance.show();
}

function submitQuickChangeGroup(e) {
  e.preventDefault();
  const code = document.getElementById('quickEmpCode').value;
  const newGroup = document.getElementById('quickNewGroup').value;

  if (!code || !newGroup) return;

  const btn = document.getElementById('btnSubmitQuickChange');
  btn.disabled = true;
  btn.textContent = 'Đang lưu...';

  const fd = new FormData();
  fd.append('action', 'update_employee_work_group');
  fd.append('employee_code', code);
  fd.append('work_group', newGroup);

  fetch('api/hrm_leave.php', { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
      btn.disabled = false;
      btn.textContent = 'Cập nhật';

      if (res.success) {
        const modalEl = document.getElementById('modalQuickChangeGroup');
        const inst = bootstrap.Modal.getInstance(modalEl);
        if (inst) inst.hide();

        loadTimelineData();
        if (document.getElementById('tabContentPlans').style.display !== 'none') {
          loadPlansData(currentPlanPage);
        }
        const matrixModal = document.getElementById('modalWorkGroupMatrix');
        if (matrixModal && matrixModal.classList.contains('show')) {
          loadWorkGroupMatrixData();
        }
      } else {
        alert(res.message || 'Lỗi cập nhật');
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.textContent = 'Cập nhật';
      alert('Lỗi kết nối: ' + err);
    });
}

function sanitizeId(str) {
  return (str || '').replace(/[^a-zA-Z0-9_-]/g, '_');
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
</script>
